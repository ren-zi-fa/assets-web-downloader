{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  // docs/ dan preview-models/ adalah project Vite terpisah (punya package.json
  // + lockfile sendiri). Tanpa ini, tsc root ikut ngecek mereka tapi deps-nya
  // tidak terinstall di CI. Masing-masing dicheck lewat workflow sendiri.
  "include": ["./**/*", ".wxt/wxt.d.ts"],
  "exclude": ["**/node_modules", ".output", "dist", "docs", "preview-models"]
}
